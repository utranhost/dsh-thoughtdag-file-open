{
  "name": "@local/thoughtdag-file-open",
  "version": "3.0.0",
  "private": true,
  "type": "module",
  "description": "Open file links clicked inside the ThoughtDAG canvas in a refined, multi-tab in-page viewer with an in-place editor, rendered with DSH UI primitives.",
  "exports": {
    ".": "./host.js",
    "./client": "./client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "host.js",
    "client.js",
    "client.*.js",
    "cordis.patch.yml",
    "vendor/codemirror/LICENSES.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [],
      "external": [
        "@deepseek-ai/dsh-client-ui-primitives"
      ]
    }
  }
}
